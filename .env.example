# Database (Supabase). The service role key is server-only: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo mode: shows the demo bar and enables one-click sample sign-in. Sample-data deployments only.
DEMO_MODE=false
# Password of the sample users (12+ characters). Used by `npm run seed` and the demo sign-in.
DEMO_PASSWORD=choose-a-long-password

# Stripe, TEST mode only (live keys are refused). Placeholders mean billing is off.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authorizes the daily maintenance job. Without it the job answers 401.
CRON_SECRET=choose-a-long-random-string
